/* Fillet circular arcs (R = 5.0) */
#161 = AXIS2_PLACEMENT_3D('PLACE_ARC_0', #115, #24, #23);
#162 = CIRCLE('C_FIL_0', #161, 5.0);

#163 = AXIS2_PLACEMENT_3D('PLACE_ARC_40', #116, #24, #23);
#164 = CIRCLE('C_FIL_40', #163, 5.0);

/* ---------------- Topological Edge Curves ---------------- */
/* Fillet boundary rails and arcs */
#171 = EDGE_CURVE('E_FIL_RAIL_START', #127, #128, #144, .T.);
#172 = EDGE_CURVE('E_FIL_RAIL_END', #129, #130, #145, .T.);
#173 = EDGE_CURVE('E_FIL_ARC_0', #127, #129, #162, .T.);
#174 = EDGE_CURVE('E_FIL_ARC_40', #128, #130, #164, .T.);

