ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Abaqus AI Agent Benchmark Stepped Bar with Fillet Transition'),'2;1');
FILE_NAME('stepped_fillet_bar.step','2026-10-03T12:00:00',('Engineer'),('SIMULIA'),'Abaqus 2025','STEP AP203 Ingestion Engine','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
/* ---------------- Units ---------------- */
#10 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );

/* ---------------- Directions and Placements ---------------- */
#20 = DIRECTION('DIR_Z_POS', (0.0, 0.0, 1.0));
#21 = DIRECTION('DIR_Z_NEG', (0.0, 0.0, -1.0));
#22 = DIRECTION('DIR_X_POS', (1.0, 0.0, 0.0));
#23 = DIRECTION('DIR_X_NEG', (-1.0, 0.0, 0.0));
#24 = DIRECTION('DIR_Y_POS', (0.0, 1.0, 0.0));
#25 = DIRECTION('DIR_Y_NEG', (0.0, -1.0, 0.0));

/* ---------------- Cartesian Points ---------------- */
/* Bottom vertices (Z = 0) */
#101 = CARTESIAN_POINT('P_B_L0', (0.0, 0.0, 0.0));
#102 = CARTESIAN_POINT('P_B_R0', (100.0, 0.0, 0.0));
#103 = CARTESIAN_POINT('P_B_R40', (100.0, 40.0, 0.0));
#104 = CARTESIAN_POINT('P_B_L40', (0.0, 40.0, 0.0));

/* Left face top vertices (X = 0, Z = 20) */
#105 = CARTESIAN_POINT('P_LT_0', (0.0, 0.0, 20.0));
#106 = CARTESIAN_POINT('P_LT_40', (0.0, 40.0, 20.0));

/* Low step top / Fillet start rail (X = 45, Z = 20) */
#107 = CARTESIAN_POINT('P_FIL_START_0', (45.0, 0.0, 20.0));
#108 = CARTESIAN_POINT('P_FIL_START_40', (45.0, 40.0, 20.0));

/* Fillet end rail / High step side start (X = 50, Z = 25) */
#109 = CARTESIAN_POINT('P_FIL_END_0', (50.0, 0.0, 25.0));
#110 = CARTESIAN_POINT('P_FIL_END_40', (50.0, 40.0, 25.0));

/* High step top corner (X = 50, Z = 40) */
#111 = CARTESIAN_POINT('P_HT_L0', (50.0, 0.0, 40.0));
#112 = CARTESIAN_POINT('P_HT_L40', (50.0, 40.0, 40.0));

/* High step right top corner (X = 100, Z = 40) */
#113 = CARTESIAN_POINT('P_HT_R0', (100.0, 0.0, 40.0));
#114 = CARTESIAN_POINT('P_HT_R40', (100.0, 40.0, 40.0));

