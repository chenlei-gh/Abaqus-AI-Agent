#266 = FACE_OUTER_BOUND('BND_LEFT', #256, .T.);
#267 = FACE_OUTER_BOUND('BND_BOT', #257, .T.);
#268 = FACE_OUTER_BOUND('BND_FRONT', #258, .T.);
#269 = FACE_OUTER_BOUND('BND_BACK', #259, .T.);

/* ---------------- Surfaces ---------------- */
/* Fillet cylinder: origin (50, 0, 25), axis along Y (0, 1, 0), radius = 5.0 */
#271 = AXIS2_PLACEMENT_3D('PLACE_FIL_CYL', #115, #24, #23);
#272 = CYLINDRICAL_SURFACE('SURF_FILLET', #271, 5.0);

/* Low step top plane: Z=20, normal (0, 0, 1) */
#273 = AXIS2_PLACEMENT_3D('PLACE_LOW_TOP', #105, #20, #22);
#274 = PLANE('SURF_LOW_TOP', #273);

/* High step side plane: X=50, normal (-1, 0, 0) */
#275 = AXIS2_PLACEMENT_3D('PLACE_HIGH_SIDE', #109, #23, #24);
#276 = PLANE('SURF_HIGH_SIDE', #275);

/* High step top plane: Z=40, normal (0, 0, 1) */
#277 = AXIS2_PLACEMENT_3D('PLACE_HIGH_TOP', #111, #20, #22);
#278 = PLANE('SURF_HIGH_TOP', #277);

/* Right end plane: X=100, normal (1, 0, 0) */
#279 = AXIS2_PLACEMENT_3D('PLACE_RIGHT', #102, #22, #24);
#280 = PLANE('SURF_RIGHT', #279);

/* Left end plane: X=0, normal (-1, 0, 0) */
#281 = AXIS2_PLACEMENT_3D('PLACE_LEFT', #101, #23, #24);
#282 = PLANE('SURF_LEFT', #281);

/* Bottom plane: Z=0, normal (0, 0, -1) */
#283 = AXIS2_PLACEMENT_3D('PLACE_BOT', #101, #21, #22);
#284 = PLANE('SURF_BOT', #283);

/* Front profile plane: Y=0, normal (0, -1, 0) */
#285 = AXIS2_PLACEMENT_3D('PLACE_FRONT', #101, #25, #22);
#286 = PLANE('SURF_FRONT', #285);

/* Back profile plane: Y=40, normal (0, 1, 0) */
#287 = AXIS2_PLACEMENT_3D('PLACE_BACK', #104, #24, #22);
#288 = PLANE('SURF_BACK', #287);

/* ---------------- Advanced Faces ---------------- */
#291 = ADVANCED_FACE('FACE_FILLET', (#261), #272, .T.);
#292 = ADVANCED_FACE('FACE_LOW_TOP', (#262), #274, .T.);
#293 = ADVANCED_FACE('FACE_HIGH_SIDE', (#263), #276, .T.);
#294 = ADVANCED_FACE('FACE_HIGH_TOP', (#264), #278, .T.);
#295 = ADVANCED_FACE('FACE_RIGHT', (#265), #280, .T.);
#296 = ADVANCED_FACE('FACE_LEFT', (#266), #282, .T.);
#297 = ADVANCED_FACE('FACE_BOT', (#267), #284, .T.);
#298 = ADVANCED_FACE('FACE_FRONT', (#268), #286, .T.);
#299 = ADVANCED_FACE('FACE_BACK', (#269), #288, .T.);

/* ---------------- Closed Shell and Solid B-Rep ---------------- */
#300 = CLOSED_SHELL('SHELL_STEPPED_FILLET_BAR', (#291, #292, #293, #294, #295, #296, #297, #298, #299));
#310 = MANIFOLD_SOLID_BREP('SOLID_STEPPED_FILLET_BAR', #300);

ENDSEC;
