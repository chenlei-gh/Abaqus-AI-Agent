#206 = ORIENTED_EDGE('*', *, *, #172, .F.);
#207 = ORIENTED_EDGE('*', *, *, #173, .F.);
#208 = ORIENTED_EDGE('*', *, *, #174, .F.);

#209 = ORIENTED_EDGE('*', *, *, #175, .T.);
#210 = ORIENTED_EDGE('*', *, *, #176, .T.);
#211 = ORIENTED_EDGE('*', *, *, #177, .T.);
#212 = ORIENTED_EDGE('*', *, *, #175, .F.);
#213 = ORIENTED_EDGE('*', *, *, #176, .F.);
#214 = ORIENTED_EDGE('*', *, *, #177, .F.);

#215 = ORIENTED_EDGE('*', *, *, #178, .T.);
#216 = ORIENTED_EDGE('*', *, *, #179, .T.);
#217 = ORIENTED_EDGE('*', *, *, #180, .T.);
#218 = ORIENTED_EDGE('*', *, *, #178, .F.);
