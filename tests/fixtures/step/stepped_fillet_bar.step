#115 = CARTESIAN_POINT('P_FIL_CTR_0', (50.0, 0.0, 25.0));
#116 = CARTESIAN_POINT('P_FIL_CTR_40', (50.0, 40.0, 25.0));

/* ---------------- Topological Vertex Points ---------------- */
#121 = VERTEX_POINT('VP_B_L0', #101);
