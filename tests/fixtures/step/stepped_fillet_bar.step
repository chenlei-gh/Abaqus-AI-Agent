#225 = ORIENTED_EDGE('*', *, *, #182, .F.);
#226 = ORIENTED_EDGE('*', *, *, #183, .F.);

#227 = ORIENTED_EDGE('*', *, *, #184, .T.);
#228 = ORIENTED_EDGE('*', *, *, #185, .T.);
#229 = ORIENTED_EDGE('*', *, *, #184, .F.);
#230 = ORIENTED_EDGE('*', *, *, #185, .F.);

#231 = ORIENTED_EDGE('*', *, *, #186, .T.);
#232 = ORIENTED_EDGE('*', *, *, #187, .T.);
#233 = ORIENTED_EDGE('*', *, *, #186, .F.);
#234 = ORIENTED_EDGE('*', *, *, #187, .F.);

#235 = ORIENTED_EDGE('*', *, *, #188, .T.);
#236 = ORIENTED_EDGE('*', *, *, #189, .T.);
#237 = ORIENTED_EDGE('*', *, *, #190, .T.);
