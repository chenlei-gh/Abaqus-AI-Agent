#240 = ORIENTED_EDGE('*', *, *, #189, .F.);
#241 = ORIENTED_EDGE('*', *, *, #190, .F.);
#242 = ORIENTED_EDGE('*', *, *, #191, .F.);

/* ---------------- Edge Loops ---------------- */
/* Fillet transition loop */
#251 = EDGE_LOOP('LOOP_FILLET', (#201, #204, #206, #207));

/* Low step top loop */
#252 = EDGE_LOOP('LOOP_LOW_TOP', (#209, #211, #205, #213));

/* High step side loop */
#253 = EDGE_LOOP('LOOP_HIGH_SIDE', (#202, #216, #220, #218));

/* High step top loop */
#254 = EDGE_LOOP('LOOP_HIGH_TOP', (#221, #223, #225, #220));

/* Right face loop */
#255 = EDGE_LOOP('LOOP_RIGHT', (#238, #228, #226, #229));

/* Left face loop */
#256 = EDGE_LOOP('LOOP_LEFT', (#237, #232, #212, #233));

/* Bottom face loop */
#257 = EDGE_LOOP('LOOP_BOT', (#235, #238, #240, #241));

/* Front face profile loop */
#258 = EDGE_LOOP('LOOP_FRONT', (#235, #227, #224, #218, #207, #213, #233));

/* Back face profile loop */
#259 = EDGE_LOOP('LOOP_BACK', (#236, #228, #225, #219, #208, #214, #234));

/* ---------------- Face Bounds ---------------- */
#261 = FACE_OUTER_BOUND('BND_FILLET', #251, .T.);
#262 = FACE_OUTER_BOUND('BND_LOW_TOP', #252, .T.);
#263 = FACE_OUTER_BOUND('BND_HIGH_SIDE', #253, .T.);
#264 = FACE_OUTER_BOUND('BND_HIGH_TOP', #254, .T.);
