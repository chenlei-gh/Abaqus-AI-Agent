#133 = VERTEX_POINT('VP_HT_R0', #113);
#134 = VERTEX_POINT('VP_HT_R40', #114);

/* ---------------- Geometric Curves ---------------- */
/* Rails along Y axis */
#141 = LINE('L_BOT_L', #101, #24);
#142 = LINE('L_BOT_R', #102, #24);
#143 = LINE('L_LT', #105, #24);
#144 = LINE('L_FIL_START', #107, #24);
#145 = LINE('L_FIL_END', #109, #24);
#146 = LINE('L_HT_L', #111, #24);
#147 = LINE('L_HT_R', #113, #24);

/* Lines in Y=0 and Y=40 planes */
#148 = LINE('L_BOT_F', #101, #22);
#149 = LINE('L_BOT_BK', #104, #22);
#150 = LINE('L_LT_F', #105, #22);
#151 = LINE('L_LT_BK', #106, #22);
#152 = LINE('L_HIGH_SIDE_F', #109, #20);
#153 = LINE('L_HIGH_SIDE_BK', #110, #20);
#154 = LINE('L_HT_F', #111, #22);
#155 = LINE('L_HT_BK', #112, #22);
#156 = LINE('L_END_R_F', #102, #20);
#157 = LINE('L_END_R_BK', #103, #20);
#158 = LINE('L_END_L_F', #101, #20);
