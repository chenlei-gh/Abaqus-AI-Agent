#175 = EDGE_CURVE('E_LT_L', #125, #126, #143, .T.);
#176 = EDGE_CURVE('E_LT_F', #125, #127, #150, .T.);
#177 = EDGE_CURVE('E_LT_BK', #126, #128, #151, .T.);

/* High step side vertical edges */
#178 = EDGE_CURVE('E_HIGH_SIDE_F', #129, #131, #152, .T.);
#179 = EDGE_CURVE('E_HIGH_SIDE_BK', #130, #132, #153, .T.);
#180 = EDGE_CURVE('E_HIGH_TOP_L', #131, #132, #146, .T.);

/* High step top edges */
#181 = EDGE_CURVE('E_HT_F', #131, #133, #154, .T.);
#182 = EDGE_CURVE('E_HT_BK', #132, #134, #155, .T.);
#183 = EDGE_CURVE('E_HT_R', #133, #134, #147, .T.);

/* Right end vertical edges */
#184 = EDGE_CURVE('E_R_V_F', #122, #133, #156, .T.);
#185 = EDGE_CURVE('E_R_V_BK', #123, #134, #157, .T.);

/* Left end vertical edges */
#186 = EDGE_CURVE('E_L_V_F', #121, #125, #158, .T.);
#187 = EDGE_CURVE('E_L_V_BK', #124, #126, #159, .T.);

/* Bottom edges */
#188 = EDGE_CURVE('E_B_F', #121, #122, #148, .T.);
#189 = EDGE_CURVE('E_B_BK', #124, #123, #149, .T.);
#190 = EDGE_CURVE('E_B_L', #121, #124, #141, .T.);
#191 = EDGE_CURVE('E_B_R', #122, #123, #142, .T.);

/* ---------------- Oriented Edges ---------------- */
#201 = ORIENTED_EDGE('*', *, *, #171, .T.);
#202 = ORIENTED_EDGE('*', *, *, #172, .T.);
#203 = ORIENTED_EDGE('*', *, *, #173, .T.);
#204 = ORIENTED_EDGE('*', *, *, #174, .T.);
