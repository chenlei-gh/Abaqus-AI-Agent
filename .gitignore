__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/
.idea/
.vscode/
.DS_Store

# Local licensed-Abaqus solver artifacts are ignored by extension below.
# machine_validation/ is controlled evidence and must never be ignored as a directory.
*.odb
*.sta
*.msg
*.dat
*.com
*.prt
*.rpy
*.rpy.*
*.rec
*.inp
*.log
*.env
*.abq
*.pac
*.res
*.sel
*.stt
*.mdl
*.lck
*.fil
*.sim

# Known transient outputs from repository-local development runs. Other run
# reports, manifests, images, and evidence remain visible to Git governance.
/runs/live_environment_gate.json
/runs/h6_grounding_validation/h6_grounding_live_result.json
/runs/**/*_script.py
/runs/images/slide_*_img_*.png
/runs/cantilever_benchmark_*/

# Abaqus session scratch written into the launch directory.
# Product runs must use an external workdir. These rules only stop
# an interactive CAE/noGUI session from showing up as repository changes.
abq.app_cache
*.app_cache
*.sat
*.sab
*.smb
*.jnl
*.cae
*.odb_f
abaqus.rpy*
abaqus_acis.log
abaqus_v6.env
*.exception

# One-off probes must not live in the repository root.
/test_probe_*.py
/probe_*.py
tools/_probe_*.py
.tmp_view/

# Life-cycle ledger written beside a solver workdir (see execution/reconciliation.py).
# It is machine-local resume state, never tracked evidence.
.state/
**/.state/run_lifecycle.json

# ODB extraction result cache (machine-local derived state, see 契约 B.2)
.cache/
.cache/results/
